# Westalife Residence — Sayaç Okuma Sistemi
# Prod ortamı şablonu: bu dosyayı ".env" olarak kopyalayıp değerleri doldurun (.env git'e girmaz).

# PostgreSQL
POSTGRES_DB=sayacokuma
POSTGRES_USER=sayacokuma
POSTGRES_PASSWORD=GUCLU-BIR-SIFRE-SECIN
POSTGRES_PORT=5432

# API'ın veritabanı bağlantısı (host: db — compose ağı içi)
DATABASE_CONNECTION="Host=db;Port=5432;Database=sayacokuma;Username=sayacokuma;Password=GUCLU-BIR-SIFRE-SECIN;Include Error Detail=true"

# Dışarıya açılan web portu (nginx)
WEB_PORT=80

# Geliştirme proxy hedefi (Vite dev server için — prod'da kullanılmaz)
VITE_API_PROXY_TARGET=http://localhost:5199
